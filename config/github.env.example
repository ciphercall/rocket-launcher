# Copy to github.env and fill in your GitHub credentials.
# Never commit github.env to git.

GITHUB_OWNER=your_github_username
GITHUB_REPO=pphl-attendance-ota
GITHUB_BRANCH=main
GITHUB_PAT=ghp_your_token_with_repo_scope

# Stable manifest URL (baked into app builds via --dart-define)
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/your_github_username/pphl-attendance-ota/main/ota/manifest.json

APP_ID=com.pphl.employee_attendance
