# Copy to github.env and fill in your GitHub credentials.
# Never commit github.env to git.

GITHUB_OWNER=ciphercall
GITHUB_REPO=rocket-launcher
GITHUB_BRANCH=main
GITHUB_PAT=ghp_your_token_with_repo_scope

# Base the OTA manifests are served from. The per-channel URL is derived from
# this: <OTA_BASE_URL>/ota/manifest.json for prod and
# <OTA_BASE_URL>/ota/beta/manifest.json for beta. Leave it unset to derive the
# same value from GITHUB_OWNER / GITHUB_REPO / GITHUB_BRANCH.
OTA_BASE_URL=https://raw.githubusercontent.com/ciphercall/rocket-launcher/main

# Build-number bands, kept disjoint per channel. The app's update check is a
# plain integer compare with nothing channel-aware in it, so a shared counter
# would let a beta publish reach production phones.
BETA_VERSION_FLOOR=9000
PROD_VERSION_CEILING=8999

APP_ID=com.pphl.employee_attendance
